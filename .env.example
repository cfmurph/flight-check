# Amadeus API credentials (free at https://developers.amadeus.com)
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here

# API environment: "test" (free sandbox) or "production"
AMADEUS_ENV=test

# Scanner settings
# Comma-separated list of origin airports to scan from (defaults to all major Canadian airports)
# SCAN_ORIGINS=YYZ,YVR,YUL,YYC,YEG

# Number of days ahead to look for deals (default: 90)
# SCAN_DAYS_AHEAD=90

# Maximum price threshold in CAD to flag as a deal (default: 300)
# DEAL_PRICE_THRESHOLD=300

# Minimum discount percentage vs average to flag as a deal (default: 20)
# DEAL_DISCOUNT_PCT=20

# Report output directory (default: ./reports)
# REPORT_DIR=./reports
