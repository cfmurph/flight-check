# ─────────────────────────────────────────────────────────────────
# PRIMARY: SerpApi (Google Flights) — recommended
# Free tier: 100 searches/month, no credit card required
# Sign up: https://serpapi.com/users/sign_up
# ─────────────────────────────────────────────────────────────────
SERPAPI_KEY=your_serpapi_key_here

# ─────────────────────────────────────────────────────────────────
# LEGACY: Amadeus Self-Service (⚠ decommissioned July 17 2026)
# Only used if SERPAPI_KEY is not set.
# ─────────────────────────────────────────────────────────────────
# AMADEUS_CLIENT_ID=your_client_id_here
# AMADEUS_CLIENT_SECRET=your_client_secret_here
# AMADEUS_ENV=test

# ─────────────────────────────────────────────────────────────────
# Scanner settings (all optional)
# ─────────────────────────────────────────────────────────────────

# Comma-separated origin airports to scan from (defaults to all Tier-1 airports)
# SCAN_ORIGINS=YYZ,YVR,YUL,YYC,YEG

# Number of days ahead to look for deals (default: 90)
# SCAN_DAYS_AHEAD=90

# Maximum price threshold in CAD to flag as a deal (default: 500)
# DEAL_PRICE_THRESHOLD=500

# Minimum discount percentage vs average to flag as a deal (default: 15)
# DEAL_DISCOUNT_PCT=15

# Report output directory (default: ./reports)
# REPORT_DIR=./reports
