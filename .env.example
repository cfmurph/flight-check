# SerpApi (Google Flights) credentials
# Free tier: 100 searches/month — sign up at https://serpapi.com/users/sign_up
SERPAPI_KEY=your_serpapi_key_here

# ─────────────────────────────────────────────────────────────────
# Scanner settings (all optional)
# ─────────────────────────────────────────────────────────────────

# Comma-separated origin airports to scan from (defaults to all Tier-1 airports)
# SCAN_ORIGINS=YYZ,YVR,YUL,YYC,YEG

# Number of days ahead to look for deals (default: 90)
# SCAN_DAYS_AHEAD=90

# Maximum price threshold in CAD to flag as a deal (default: 300)
# DEAL_PRICE_THRESHOLD=300

# Minimum discount percentage vs average to flag as a deal (default: 20)
# DEAL_DISCOUNT_PCT=20

# Report output directory (default: ./reports)
# REPORT_DIR=./reports
